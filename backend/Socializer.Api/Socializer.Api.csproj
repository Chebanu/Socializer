<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>a91290e7-554d-4681-aeef-adb9ae61dba0</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Socializer.Domain\Socializer.Domain.csproj" />
      <ProjectReference Include="..\Socializer.Application\Socializer.Application.csproj" />
      <ProjectReference Include="..\Socializer.Infrastructure\Socializer.Infrastructure.csproj" />
      <ProjectReference Include="..\Socializer.Contracts\Socializer.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup Label="Authentication (HTTP middleware — belongs in the web layer)">
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup Label="Observability / API surface">
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup Label="Design-time only">
      <!-- The one EF package that legitimately stays here: `dotnet ef` resolves Design from the
           STARTUP project, not from the project passed via the "project" option.
           Build-time only, never published. -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>

</Project>
